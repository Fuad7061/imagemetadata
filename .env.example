# Optional. If omitted, a random admin key is generated on first boot and
# written to /app/data/ADMIN_KEY.txt (also printed once to the container logs).
ADMIN_KEY=

PORT=3000
HOST=0.0.0.0
DATA_DIR=/app/data

# Hard-capped at 10 days even if set higher.
LOG_RETENTION_DAYS=10

MAX_BODY_SIZE_MB=15
SESSION_TTL_HOURS=168

# Used for generated links in API responses and /docs. Leave blank to use request host.
PUBLIC_BASE_URL=

# Set to 1 behind a reverse proxy to honour X-Forwarded-For.
TRUST_PROXY=

# Comma-separated origins for browser CORS, or * for all (default).
CORS_ORIGIN=*
